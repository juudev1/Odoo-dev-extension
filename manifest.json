{
    "manifest_version": 3,
    "name": "Odoo dev tools",
    "description": "Herramienta técnica para desarrolladores de Odoo. Inspecciona modelos, genera XPath y ejecuta métodos.",
    "version": "1.0",
    "action": {
        "default_popup": "/static/index.html",
        "default_icon": "/assets/images/odoo_dev.png"
    },
    "default_locale": "en",
    "icons": {
        "16": "/assets/images/icon_16.png",
        "32": "/assets/images/icon_32.png",
        "48": "/assets/images/icon_48.png",
        "128": "/assets/images/odoo_dev.png"
    },
    "permissions": [
        "storage"
    ],
    "content_scripts": [
        {
            "run_at": "document_end",
            "js": [
                "dist/loader.bundle.js"
            ],
            "world": "MAIN",
            "all_frames": true,
            "exclude_matches": [
                "https://*/web/login*"
            ],
            "matches": [
                "<all_urls>"
            ]
        },
        {
            "run_at": "document_end",
            "js": [
                "dist/contentScript.bundle.js"
            ],
            "world": "ISOLATED",
            "all_frames": true,
            "matches": [
                "<all_urls>"
            ],
            "exclude_matches": [
                "https://*/web/login*"
            ]
        }
    ],
    "web_accessible_resources": [
        {
            "resources": [
                "dist/*.bundle.js",
                "src/injected/*"
            ],
            "matches": [
                "<all_urls>"
            ]
        }
    ],
    "content_security_policy": {
        "extension_pages": "script-src 'self'; object-src 'self';"
    }
}